<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Mattdaemon</string>
	<key>CFBundleExecutable</key>
	<string>MLSuiteTerminal</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.mathiassivertsen.mlsuiteterminal</string>
	<key>CFBundleName</key>
	<string>Mattdaemon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- What the permission dialogs say when macOS does ask. They do not stop
	     the asking - only granting Full Disk Access once does that - but an
	     unexplained "Mattdaemon wants access to your Documents" is a dialog
	     nobody can make an informed decision about. -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Your terminal sessions run here, so Claude Code can read and edit the projects you open.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>So a session you open on the Desktop can read and edit the files in it.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>So a session can read files you have just downloaded.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>So a session opened on an external disk can read and edit the files on it.</string>
</dict>
</plist>
